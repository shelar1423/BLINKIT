# Optional override of the public Hot Wheels token already configured in analytics.ts.
# Use a project token, never a personal API key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Use https://eu.i.posthog.com for an EU project.

# Local development is excluded by default.
VITE_POSTHOG_ENABLE_DEV=false
# 10% replay sampling is enabled by default. Set false to turn replay off.
# Inputs are masked; canvas/camera recording is blocked.
VITE_POSTHOG_SESSION_REPLAY=true
